# IntentGuard runtime configuration (copy to .env — never commit a populated .env)
# Primary database: PostgreSQL star schema (Milestone 4).
# Example (URL-encode special chars in the password, e.g. @ -> %40):
#   DATABASE_URL=postgresql+psycopg://admin:secret%402026@192.168.1.10:5432/intentguard_dw
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/intentguard_dw
# Local fallback when Postgres is unreachable (dev/tests use SQLite automatically)
SQLITE_FALLBACK_URL=sqlite:///./data/intentguard.db
# Scoring policy
WTS_THRESHOLD=0.5
WTS_REVIEW_BAND_LOW=0.4
WTS_REVIEW_BAND_HIGH=0.6
WTS_MAX_TRANSCRIPT_CHARS=200000
WTS_MAX_UPLOAD_BYTES=204800
MODEL_VERSION=baseline-tfidf-lr-v1
# New transcripts are assumed to belong to this product unless stated otherwise
DEFAULT_PRODUCT_ID=product_b
